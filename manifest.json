{
  "manifest_version": 3,
  "name": "MindRight",
  "version": "0.1.2",
  "permissions": ["storage", "alarms", "tabs", "notifications"],
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["Content.js"]
    }
  ]
}
